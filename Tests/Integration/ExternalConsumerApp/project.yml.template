name: PocketRootExternalConsumerApp

options:
  bundleIdPrefix: com.jacklv.tests
  deploymentTarget:
    iOS: "18.0"
  createIntermediateGroups: true

settings:
  base:
    SWIFT_VERSION: "5.0"
    IPHONEOS_DEPLOYMENT_TARGET: "18.0"
    TARGETED_DEVICE_FAMILY: "1,2"
    GENERATE_INFOPLIST_FILE: YES
    CURRENT_PROJECT_VERSION: 1
    MARKETING_VERSION: 0.2.0

packages:
  PocketRoot:
__POCKETROOT_PACKAGE_SOURCE__

targets:
  PocketRootExternalConsumerApp:
    type: application
    platform: iOS
    deploymentTarget: "18.0"

    sources:
      - path: Sources
      - path: Resources
        buildPhase: resources

    dependencies:
      - package: PocketRoot
        product: PocketRoot
      - package: PocketRoot
        product: PocketRootIshRuntimeIntegration

    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.jacklv.tests.PocketRootExternalConsumerApp
        PRODUCT_NAME: PocketRootExternalConsumerApp
        ARCHS: arm64
        "EXCLUDED_ARCHS[sdk=iphonesimulator*]": x86_64
        ONLY_ACTIVE_ARCH: YES
        SUPPORTS_MACCATALYST: NO
        ENABLE_DEBUG_DYLIB: NO
        SWIFT_STRICT_CONCURRENCY: complete
        SWIFT_TREAT_WARNINGS_AS_ERRORS: YES

    info:
      path: Sources/Info.plist
      properties:
        CFBundleDisplayName: PocketRoot Consumer
        CFBundleShortVersionString: "$(MARKETING_VERSION)"
        CFBundleVersion: "$(CURRENT_PROJECT_VERSION)"
        UILaunchScreen: {}
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
          - UIInterfaceOrientationPortraitUpsideDown
        "UISupportedInterfaceOrientations~ipad":
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        UIApplicationSceneManifest:
          UIApplicationSupportsMultipleScenes: false
          UISceneConfigurations:
            UIWindowSceneSessionRoleApplication:
              - UISceneConfigurationName: Default Configuration
                UISceneDelegateClassName: "$(PRODUCT_MODULE_NAME).ExternalConsumerSceneDelegate"

  PocketRootExternalConsumerAppUITests:
    type: bundle.ui-testing
    platform: iOS
    deploymentTarget: "18.0"

    sources:
      - path: UITests

    dependencies:
      - target: PocketRootExternalConsumerApp

    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.jacklv.tests.PocketRootExternalConsumerAppUITests
        GENERATE_INFOPLIST_FILE: YES
        SWIFT_VERSION: "5.0"
        SWIFT_STRICT_CONCURRENCY: complete
        SWIFT_TREAT_WARNINGS_AS_ERRORS: YES
        TEST_TARGET_NAME: PocketRootExternalConsumerApp

schemes:
  PocketRootExternalConsumerApp:
    build:
      targets:
        PocketRootExternalConsumerApp: all
        PocketRootExternalConsumerAppUITests: [test]
    test:
      targets:
        - PocketRootExternalConsumerAppUITests
    run:
      config: Debug
    archive:
      config: Release
